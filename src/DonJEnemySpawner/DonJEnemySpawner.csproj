<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>DonJCustomNpcPlacer</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>

    <!-- Je sors directement la DLL dans bin\Release. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Chemin GTA Enhanced attendu sur ce poste, surchargeable via /p:GtaRoot=... -->
    <DefaultEnhancedGtaRoot>C:\Program Files (x86)\Steam\steamapps\common\Grand Theft Auto V Enhanced</DefaultEnhancedGtaRoot>
    <GtaRoot Condition="'$(GtaRoot)' == '' and Exists('$(DefaultEnhancedGtaRoot)\GTA5_Enhanced.exe')">$(DefaultEnhancedGtaRoot)</GtaRoot>
    <GtaRoot Condition="'$(GtaRoot)' == ''">$(DefaultEnhancedGtaRoot)</GtaRoot>
    <GtaScriptsDir Condition="'$(GtaScriptsDir)' == ''">$(GtaRoot)\Scripts</GtaScriptsDir>

    <!-- Je ne touche jamais au dossier GTA pendant une compilation normale. -->
    <DeployToGta Condition="'$(DeployToGta)' == ''">false</DeployToGta>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</RepositoryRoot>
    <PackageGameReadyScript>$(RepositoryRoot)\tools\package-game-ready.ps1</PackageGameReadyScript>
    <DeployGameReadyScript>$(RepositoryRoot)\tools\deploy-game-ready.ps1</DeployGameReadyScript>
    <NibAbiValidatorProject>$(RepositoryRoot)\tools\NibAbiValidator\DonJ.NibAbiValidator.csproj</NibAbiValidatorProject>
    <NibAbiValidatorPath>$(RepositoryRoot)\tools\NibAbiValidator\bin\$(Configuration)\DonJ.NibAbiValidator.exe</NibAbiValidatorPath>
    <NibAbiContractPath>$(RepositoryRoot)\tools\NibAbiValidator\contracts\NIBScriptHookVDotNet2-2.11.6.abi.xml</NibAbiContractPath>

    <!-- API v2 cible : NIBScriptHookVDotNet2.dll en priorité, sinon ScriptHookVDotNet2.dll. -->
    <ShvdnApiReferenceName Condition="Exists('$(GtaRoot)\NIBScriptHookVDotNet2.dll')">NIBScriptHookVDotNet2</ShvdnApiReferenceName>
    <ShvdnApiPath Condition="Exists('$(GtaRoot)\NIBScriptHookVDotNet2.dll')">$(GtaRoot)\NIBScriptHookVDotNet2.dll</ShvdnApiPath>
    <ShvdnApiReferenceName Condition="'$(ShvdnApiReferenceName)' == '' and Exists('$(GtaRoot)\ScriptHookVDotNet2.dll')">ScriptHookVDotNet2</ShvdnApiReferenceName>
    <ShvdnApiPath Condition="'$(ShvdnApiPath)' == '' and Exists('$(GtaRoot)\ScriptHookVDotNet2.dll')">$(GtaRoot)\ScriptHookVDotNet2.dll</ShvdnApiPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(ShvdnApiReferenceName)' != ''">
    <Reference Include="$(ShvdnApiReferenceName)">
      <HintPath>$(ShvdnApiPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <Target Name="ValidateGtaReference" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(GtaRoot)\GTA5_Enhanced.exe')"
      Text="GTA5_Enhanced.exe introuvable dans '$(GtaRoot)'. Corrige GtaRoot dans DonJEnemySpawner.csproj avec le vrai dossier GTA Enhanced." />

    <Error
      Condition="'$(ShvdnApiPath)' == ''"
      Text="Ni NIBScriptHookVDotNet2.dll ni ScriptHookVDotNet2.dll n'ont ete trouves dans '$(GtaRoot)'. GtaRoot doit pointer vers le dossier GTA contenant l'API v2 chargee par le runtime." />
  </Target>

  <Target Name="CreateLocalEndll" AfterTargets="Build">
    <Delete Files="$(TargetDir)$(AssemblyName).ENdll"
            Condition="Exists('$(TargetDir)$(AssemblyName).ENdll')" />

    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(TargetDir)$(AssemblyName).ENdll"
          SkipUnchangedFiles="false" />
  </Target>

  <Target Name="ValidateDeployTarget"
          Condition="'$(Configuration)' == 'Release' and '$(DeployToGta)' == 'true'">
    <Error Condition="'$(GtaScriptsDir)' == ''"
           Text="GtaScriptsDir doit etre defini pour deployer dans GTA." />
    <Error Condition="!Exists('$(GtaRoot)\GTA5_Enhanced.exe')"
           Text="Le dossier GTA indique est invalide : $(GtaRoot)" />
    <Error Condition="!Exists('$(PackageGameReadyScript)')"
           Text="Script de packaging introuvable : $(PackageGameReadyScript)" />
    <Error Condition="!Exists('$(DeployGameReadyScript)')"
           Text="Script de deploiement introuvable : $(DeployGameReadyScript)" />
    <Error Condition="!Exists('$(NibAbiValidatorProject)')"
           Text="Projet du validateur ABI introuvable : $(NibAbiValidatorProject)" />
    <Error Condition="!Exists('$(NibAbiContractPath)')"
           Text="Contrat ABI NIB introuvable : $(NibAbiContractPath)" />
  </Target>

  <Target Name="BuildNibAbiValidator"
          DependsOnTargets="ValidateDeployTarget"
          Condition="'$(Configuration)' == 'Release' and '$(DeployToGta)' == 'true'">
    <!-- Je restaure puis construis le garde-fou pour garder aussi le build direct autonome. -->
    <MSBuild Projects="$(NibAbiValidatorProject)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" />
    <Error Condition="!Exists('$(NibAbiValidatorPath)')"
           Text="Validateur ABI non produit : $(NibAbiValidatorPath)" />
  </Target>

  <Target Name="CreateGtaDeployPackage"
          DependsOnTargets="BuildNibAbiValidator"
          Condition="'$(Configuration)' == 'Release' and '$(DeployToGta)' == 'true'">
    <PropertyGroup>
      <!-- Je normalise les chemins sans séparateur final avant de les citer pour PowerShell. -->
      <GtaDeployBuildDirectory>$([System.IO.Path]::GetFullPath('$(TargetDir).'))</GtaDeployBuildDirectory>
      <GtaDeployPackageDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)game-ready'))</GtaDeployPackageDirectory>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(PackageGameReadyScript)&quot; -Configuration &quot;$(Configuration)&quot; -RepositoryRoot &quot;$(RepositoryRoot)&quot; -BuildDirectory &quot;$(GtaDeployBuildDirectory)&quot; -OutputDirectory &quot;$(GtaDeployPackageDirectory)&quot; -DependencyDirectory &quot;$(GtaRoot)&quot; -AbiValidatorPath &quot;$(NibAbiValidatorPath)&quot; -AbiContractPath &quot;$(NibAbiContractPath)&quot; -Force" />
  </Target>

  <Target Name="DeployAsEndll"
          AfterTargets="CreateLocalEndll"
          DependsOnTargets="CreateGtaDeployPackage"
          Condition="'$(Configuration)' == 'Release' and '$(DeployToGta)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(DeployGameReadyScript)&quot; -PackageDirectory &quot;$(GtaDeployPackageDirectory)&quot; -GtaRoot &quot;$(GtaRoot)&quot; -GtaScriptsDir &quot;$(GtaScriptsDir)&quot; -AbiValidatorPath &quot;$(NibAbiValidatorPath)&quot; -AbiContractPath &quot;$(NibAbiContractPath)&quot;" />
    <Message Importance="High"
              Text="DonJ Custom NPC Placer deploye vers : $(GtaScriptsDir)\$(AssemblyName).ENdll" />
  </Target>
</Project>
